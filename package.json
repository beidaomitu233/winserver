{
    "name":  "winserver",
    "version":  "0.2.0",
    "private":  true,
    "description":  "WinServer Cloud Stack Desktop",
    "scripts":  {
                    "dev":  "cd frontend \u0026\u0026 npm run dev",
                    "build":  "cd frontend \u0026\u0026 npm run build",
                    "tauri:dev":  "cd frontend \u0026\u0026 npm run tauri dev",
                    "tauri:build":  "cd frontend \u0026\u0026 npm run tauri build",
                    "test":  "node tests/run-all.js",
                    "test:resources":  "node tests/verify-runtime-resources.js",
                    "test:backend":  "cargo test --test api_integration -- --nocapture",
                    "test:unit":  "cargo test --lib -- --nocapture",
                    "test:e2e":  "npx playwright test",
                    "test:report":  "start test-results/index.html",
                    "test:e2e:runner":  "node tests/run-e2e.js",
                    "test:e2e:skip":  "node tests/run-e2e.js --skip-start",
                    "test:e2e:pages":  "node tests/run-e2e.js --skip-start --pages"
                },
    "directories":  {
                        "doc":  "docs",
                        "test":  "tests"
                    },
    "keywords":  [

                 ],
    "author":  "",
    "license":  "ISC",
    "devDependencies":  {
                            "@playwright/test":  "^1.60.0"
                        }
}
