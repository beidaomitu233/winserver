{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinServer",
  "version": "1.1.1",
  "identifier": "com.winserver.cloudstack",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WinServer Cloud Stack",
        "width": 1280,
        "height": 800,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../../runtime/nginx-1.26.3.zip",
      "../../runtime/mysql-8.0.12-winx64.zip",
      "../../runtime/redis-7.2.4/redis-server.exe",
      "../../runtime/redis-7.2.4/redis-cli.exe",
      "../../runtime/redis-7.2.4/redis.conf",
      "../../runtime/redis-7.2.4/run.bat",
      "../../runtime/minio/minio.exe",
      "../../runtime/minio/mc.exe",
      "../../runtime/minio/minio.env",
      "../../runtime/minio/run.bat"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFREVFMUIyRjJERjI2NTMKUldSVEp0L3lzdUhlbnFna3YxSXFvUXl3d3VVYUlQckY4akRsMitUMzBCdUg1WVNHM2NnaDZrd3QK",
      "endpoints": [
        "https://github.com/beidaomitu233/winserver/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
