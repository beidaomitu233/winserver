{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinServer",
  "version": "0.1.0",
  "identifier": "com.winserver.cloudstack",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WinServer Cloud Stack",
        "width": 1280,
        "height": 800,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../runtime/nginx-1.26.3.zip",
      "../../runtime/mysql-8.0.12-winx64.zip",
      "../../runtime/redis-7.2.4/redis-server.exe",
      "../../runtime/redis-7.2.4/redis-cli.exe",
      "../../runtime/minio/minio.exe"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
